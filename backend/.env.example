# Supabase — backend only. The frontend never reads these (PRD §8.2 data boundary).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth — argon2 + JWT (PRD §6.1)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Fallback base currency for orgs created before one is chosen, and the value
# GET /api/config reports to the browser. Each organization stores its own
# base_currency; this is only the default. Optional — defaults to INR.
BASE_CURRENCY=INR

# Origin serving the WebMCP partner-demo page (PRD §7 cross-origin row). It must
# NOT be this app's own origin, or `getTools({fromOrigins})` returns same-origin
# tools and the cross-origin demo proves nothing. Locally this is the static
# server `pnpm run dev:partner` starts. Optional — defaults to the value below
# in development, and to nothing in production (where a localhost default would
# make /agent embed an iframe pointing at each visitor's own machine).
PARTNER_DEMO_ORIGIN=http://localhost:4201

# Set by the deploy, not here. It is what tells EnvService this is production
# (see PARTNER_DEMO_ORIGIN above) — leave it unset locally.
# NODE_ENV=production

PORT=3000

# NOTE: there is deliberately no GEMINI_API_KEY here. The user's Gemini key
# lives in the browser and must never reach this service (PRD §8.3 LLM boundary).
